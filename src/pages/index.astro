---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.jsx";
import { Button } from "@/components/ui/Button";
import Section from "@/components/Section";
import Footer from "@/components/Footer.jsx";
import SEO from "@/components/SEO.astro";

import {
  TypographyH1,
  TypographyH2,
  TypographyH3,
  TypographyP,
} from "../components/ui/Typography.jsx";

import { buttonVariants } from "@/components/ui/Button";

import ProjectCard from "../components/ProjectCard.jsx";
import cicloMockup from "@/assets/projects/PeriodTracker/ciclo-mockup.png";
import periodTracker from "@/assets/projects/PeriodTracker/onboarding.png";
import stars from "@/assets/stars.png";
import design_system from "@/assets/projects/DesignSystem/design_system_test.png";
import realestate_hero from "@/assets/projects/RealEstate/hero.png";
import ultrahuman_mockup from "@/assets/projects/Ultrahuman/ultrahuman_mockup.png";
import linkedin_img from "@/assets/About/linkedin_img.png";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build

let projectCardsList = [
  {
    title: "Ultrahuman",
    description: "UI/UX Design • 2025",
    content: "Transforming complex health data into actionable insights.",
    badgesList: ["UX/UI Case Study", "Wearables"],
    imageSrc: ultrahuman_mockup.src,
    imageAlt: "Project thumbnail",
    imageBgColor: "bg-secondary-500",
    projectUrl: "/nathaliatroina/projects/ultrahuman",
  },
  {
    title: "Design System",
    description: "Web Development",
    content: "A scalable design system built for high-performance.",
    badgesList: ["Tokens", "Scalability", "Personal Project"],
    imageSrc: design_system.src,
    imageAlt: "Project thumbnail",
    imageBgColor: "bg-tertiary-500",
    projectUrl: "/nathaliatroina/projects/design-system",
  },
  {
    title: "Period Tracker",
    description: "Mobile App",
    content: "Balancing business constraints with the ideal user experience.",
    badgesList: ["Innovation", "MVP", "Branding"],
    imageSrc: periodTracker.src,
    imageAlt: "Project thumbnail",
    imageBgColor: "bg-primary-500",
    projectUrl: "/nathaliatroina/projects/period-tracker",
  },
  {
    title: "Real Estate",
    description: "Product Strategy",
    content:
      "Reducing platform exit points by integrating micro-location data.",
    badgesList: ["UX Designer", "UX Research"],
    imageSrc: realestate_hero.src,
    imageAlt: "Project thumbnail",
    imageBgColor: "bg-secondary-500",
    projectUrl: "/nathaliatroina/projects/real-estate",
  },
  // {
  //   title: "Spirit Airlines",
  //   description: "Product Strategy",
  //   content: "Strategic approach to enhance company results through design.",
  //   badgesList: ["UX Design", "A/B Testing"],
  //   imageSrc: "https://placehold.co",
  //   imageAlt: "Project thumbnail",
  //   imageBgColor: "bg-neutral-500",
  //   projectUrl: "/nathaliatroina/projects/spirit-airlines",
  // },
];
---

<Layout
  title="Nathalia Troina | Product Designer & UX/UI Designer in NYC"
  scrollTopButton={false}
>
  <Fragment slot="seo">
    <SEO
      title="Nathalia Troina | Product Designer & UX/UI Designer in NYC"
      description="Descrição da minha página"
      url="https://nathalia-lt.github.io/nathaliatroina/"
    />
  </Fragment>

  <!-- Hero section -->
  <!-- aqui nessa classe eu fiz o "media-query" -->

  <section class="py-4xl md:py-44 relative">
    <TypographyH1 className="mb-xl "
      >I am a UX/UI Designer <br /> Based in NYC</TypographyH1
    >
    <TypographyP variant="large" className="mb-4xl">
      Combines user‑centered design with technical feasibility to enhance
      company results. I balance the ideal user experience with business
      constraints to ensure the best outcomes are achieved.
    </TypographyP>
    <Button asChild>
      <a
        class={buttonVariants({ variant: "default", size: "default" }) +
          " w-44 h-4xl!"}
        href="/nathaliatroina/nathaliatroinaresume.pdf"
        target="_blank"
      >
        Resume
      </a></Button
    >
    <img
      src={stars.src}
      alt="start image"
      class="absolute bottom-0 right-4 w-24 pointer-events-none"
    />
  </section>

  <Section title="Recent Projects" className="mb-3xl">
    <!-- aspect-video para manter o alinhamento perfeito -->
    <!-- Grid: 1 coluna no mobile, 2 colunas no desktop -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-xl mt-md md:mt-xs">
      {
        projectCardsList.map((project) => {
          return (
            <ProjectCard
              title={project.title}
              description={project.description}
              content={project.content}
              badgesList={project.badgesList}
              imageSrc={project.imageSrc}
              imageAlt={project.imageAlt}
              imageBgColor={project.imageBgColor}
              projectUrl={project.projectUrl}
            />
          );
        })
      }
    </div>
  </Section>

  <Section id="aboutme" title="About Me">
    <div class="flex gap-3xl md:gap-5xl flex-col-reverse md:flex-row">
      <div class="flex-2 mb-5xl md:mb-3xl">
        <TypographyP>
          I am a UX/Product designer passionate about blending creativity with
          problem‑solving to craft intuitive digital experiences. My training in
          modern web development and user experience principles provides a
          strong technical foundation, enabling me to design with feasibility in
          mind and collaborate effectively with cross‑functional teams.
        </TypographyP>
        <TypographyP>
          Before transitioning into design, I worked as a mental health nurse,
          collaborating daily with psychiatrists and psychologists to analyze
          patient behavior. This experience sharpened my ability to observe,
          empathize, and understand human needs, skills I now apply directly to
          creating user‑centered solutions.
        </TypographyP>
        <TypographyP>
          In my free time, you’ll often find me soaking up the sun with a book
          or exploring new food spots.
        </TypographyP>
      </div>
      <div class="flex-1 flex justify-center items-start">
        <div class="md:max-w-[280px] mt-3xl md:mt-0 rounded overflow-hidden">
          <img
            class="aspect-square object-cover"
            src={linkedin_img.src}
            alt="linkedin image"
          />
        </div>
      </div>
    </div>
  </Section>
</Layout>
