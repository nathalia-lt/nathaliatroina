---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.jsx";
import {
  TypographyH1,
  TypographyP,
  TypographyH3,
  TypographyH4,
} from "@/components/ui/Typography";
import Footer from "@/components/Footer.jsx";
import { IconMapPin } from "@tabler/icons-react";
import ProductPageSection from "@/components/ProductPageSection";

import linkedin_img from "@/assets/About/linkedin_img.png";
---

<Layout title="About">
  <main>
    <Section>
      <div class="flex gap-5xl">
        <div class="flex-2">
          <TypographyH1>About me</TypographyH1>
          <TypographyP>
            I am a UX designer with a passion for creating intuitive and
            engaging digital experiences. With a background in design and a keen
            eye for detail, I strive to understand user needs and translate them
            into effective design solutions. My approach combines research,
            creativity, and collaboration to deliver products that not only meet
            business goals but also delight users.
          </TypographyP>
          <TypographyP>
            Before transitioning into design, I worked as a mental health nurse,
            collaborating daily with psychiatrists and psychologists to analyze
            patient behavior. This experience sharpened my ability to observe,
            empathize, and understand human needs, skills I now apply directly
            to creating user‑centered solutions.
          </TypographyP>
          <TypographyP>
            In my free time, you’ll often find me soaking up the sun with a book
            or exploring new food spots.
          </TypographyP>
          <TypographyP <span className="flex items-center gap-1">
            <IconMapPin />New York City</TypographyP
          >
        </div>
        <div class="flex-1">
          <img src={linkedin_img.src} alt="linkedin image" />
        </div>
      </div>
    </Section>

    <ProductPageSection title="Education">
      <div class="flex justify-between mb-xl">
        <TypographyH4
          ><strong>Design Circuit Academy</strong> | Product Design Program</TypographyH4
        >
        <TypographyH4>2024</TypographyH4>
      </div>
      <div class="flex justify-between mb-xl">
        <TypographyH4
          ><strong>Flatiron School</strong> | Full Stack Web Development Program</TypographyH4
        >
        <TypographyH4>2022</TypographyH4>
      </div>
      <div class="flex justify-between mb-xl">
        <TypographyH4
          ><strong
            >Instituto de Administração Hospitalar e Ciências da Saúde</strong
          > | MBA Auditing</TypographyH4
        >
        <TypographyH4 />
      </div>
      <div class="flex justify-between mb-xl">
        <TypographyH4
          ><strong>Centro Universitário Metodista IPA</strong> | BS Nursing</TypographyH4
        >
        <TypographyH4 />
      </div>
    </ProductPageSection>
  </main>
</Layout>
