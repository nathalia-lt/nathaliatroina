---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.jsx";
import ProjectHero from "../../components/ProjectHero.jsx";
import design_system from "@/assets/projects/designsystem/design_system.png"
import ProjectOverview from "../../components/ProjectOverview.jsx";
import ResearchBlock from "@/components/ResearchBlock";
import {TypographyList} from "@/components/ui/Typography";
import ProductPageSection from "@/components/ProductPageSection";
import ImpactSection from "@/components/ImpactSection";
---

<Layout title="Design System">
  <main>
    <ProjectHero
      title="Design System"
      subtitle="A scalable design system built for high-performance."
      year="2026"
      role="UX Engineer, Frontend Developer"
      imageSrc={design_system.src}
      imageAlt="Project thumbnail"
      imageBgColor="bg-tertiary-500"
    />

    <ProjectOverview
      timeline="Always evolving"
      context="When I first started building my personal portfolio, it was written entirely in HTML, CSS, and vanila JavaScript. As the project grew, I realized that the codebase was becoming increasingly repetitive and difficult to scale. I found myself duplicating UI patterns, rewriting similar components, and manually maintaining styles across multiple pages. This lack of structure led to visual inconsistencies, slower development, and a growing maintenance burden. To solve this, I migrated the project to HTML, CSS, React, and Next.js, which allowed me to adopt a component‑based architecture. I decided to build a complete Design System, a foundation that would support the project’s growth and demonstrate my ability to think like a Product Designer."

      problem="During the early iterations of the portfolio, I identified several issues commonly found in projects without a system:"
      goals={[
        "Consistency: Create a unified visual language with clear guidelines.",
        "Scalability: Enable new pages and components to be built without rework.",
        "Efficiency: Reduce development time by providing reusable components.",
        "Accessibility: Ensure the design system is inclusive and usable for all users.",
        "Flexibility: Ensure the design system is flexible enough to accommodate future growth and changes.",
      ]}
      process="Research, Design tokens, components and tech implemetation"
      tools={[
        "Figma", "VS Code", "React", "Next.js", "TailwindCSS"
      ]}
    />

    <ResearchBlock
      title="Research"
      items={[
        {
          title: "Desk Research",
          description:
            "Before creating any components, I studied how established systems structure their foundations. I analyzed the design tokens, components, and documentation of Material Design, Ant Design, and Bootstrap to understand their approaches to scalability, consistency, and accessibility.",
        },
        {
          title: "Key Findings",
          description:
            "I discovered that successful design systems prioritize a clear visual language, reusable components, and comprehensive documentation. They also emphasize accessibility and responsiveness, ensuring that the system can adapt to various devices and user needs.",
        },
      ]}
    />
    <!-- aqui em cima no key findings vai uma lista -->


    <ImpactSection
      title="Impact"
      impacts={[
        {
          icon: "Code",
          title: "xxxxx",
          description:
            "60% less duplicate work across the codebase.",
        },
        {
          icon: "code",
          title: "Creation progression",
          description:
            "40% faster page creation process.",
        },
        {
          icon: "chart",
          title: "xxxx",
          description:
            "Improved responsiveness.",
        },
        {
          icon: "heart",
          title: "Mantained consistency",
          description:
            "Easier to maintain consistency and updates across the project.",
        },
      ]}
      nextSteps={[
        "xxx",
        "xxxx.",
        "xxx",
      ]}
    >
      <TypographyList list={[
        "Tokens are the foundation of any system.",
        "A Design System is about decision‑making, scale, and efficiency.",
        "Even small projects benefit from systemic thinking.",
        "Collaboration between designers and developers is crucial for the success of a design system.",
      ]} />
    </ImpactSection>

  </main>
</Layout>