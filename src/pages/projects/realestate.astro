    />

    
    <ImpactSection
      title="Impact"
      impacts={[
        {
          icon: "heart",
          title: "xxxxx",
          description:
            "Optimized user engagement by integrating micro-location data directly into property pages, resulting in a 45% increase in average session duration and a significant reduction in platform exit rates.",
        },
        {
          icon: "code",
          title: "xxxxx",
          description:
            "Redesigned the conversion funnel using a context-aware message integration, which led to 60% of incoming leads being pre-qualified with specific property data, accelerating the broker’s response time.",
