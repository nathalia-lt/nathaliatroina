      role="UX Engineer"
      imageSrc={realestatehero.src}     
    />

    <ProjectOverview
      timeline="3 months"
      context="Alto Padrão is a responsive web platform designed to bridge the gap between affluent clients and specialized brokers. The platform simplifies high-end property discovery, provides immersive architectural overviews."

      problem="Alto Padrão is a responsive web platform designed to bridge the gap between affluent clients and specialized brokers. The platform simplifies high-end property discovery, provides immersive architectural overviews."

      goals={[
        "Nao consigo colocar lista aqui sem dar erro.",
      ]}
      process="Desk research, competitive analysis, heuristic analysis, HMW,prototyping, user testing."
      tools={[
        "Figma"
      ]}
    />

    <ResearchBlock
      title="Research"
      items={[
        {
          title: "",
          description:
            "To understand the current landscape of real estate platforms and identify opportunities for improvement, I conducted comprehensive research. Secondary data were collected and analyzed from sources such as: GOV, Exame, Diário do Comércio, and NMSC.",
        },
        {
          title: "Key Findings",
          description:
            "quero colocar lista aqui",
        },
        {
          title: "Competitive Analysis",
          description:
