---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.jsx";
import ProjectHero from "../../components/ProjectHero.jsx";
import realestatehero from "@/assets/projects/RealEstate/realestate_hero.png";
import ProjectOverview from "../../components/ProjectOverview.jsx";
import ResearchBlock from "@/components/ResearchBlock";
import competitive_analysis from "@/assets/projects/RealEstate/competitive_analisys.png";
import ProductPageSection from "@/components/ProductPageSection";
import {
  TypographyH3,
  TypographyH4,
  TypographyList,
  TypographyP,
} from "@/components/ui/Typography";
import ImpactSection from "@/components/ImpactSection";
import InsightsBlock from "@/components/InsightsBlock";
import { ChatGroup } from "@/components/Chatbubble.jsx";
import ImageSection from "@/components/ImageSection";
import BeforeAfterToggle from "@/components/BeforeAfterToggle";
import SEO from "@/components/SEO.astro";

import aptpage from "@/assets/projects/RealEstate/real_estate_aptpage.png";
import aptbefore from "@/assets/projects/RealEstate/apt_before.png";
import filterbefore from "@/assets/projects/RealEstate/filter_before.png";
import filterafter from "@/assets/projects/RealEstate/filter_after.png";
import aptafter from "@/assets/projects/RealEstate/apt_after.png";
import filterpage from "@/assets/projects/RealEstate/filterpage.png";
import hero_img from "@/assets/projects/RealEstate/hero.png";
import opportunity_tree from "@/assets/projects/RealEstate/opportunity_solution_tree.png";

const insightsBlockItems = [
  {
    description:
      "When I am searching for a property, I want to filter by specific attributes and lifestyle amenities, so that I don't waste time scrolling through thousands of irrelevant, mass-market listings.",
    icon: "rocket",
  },
  {
    description:
      "When I evaluate a potential home, I want to explore the surrounding premium services and safety data within the same platform, so that I can make a confident decision without the friction of switching between multiple tabs.",
    icon: "rocket",
  },
  {
    description:
      "When I find a property that interests me, I want to initiate a direct, context-aware conversation with a specialized broker, so that I can get immediate answers without having to repeat the property details or fill out long, impersonal forms.",
    icon: "rocket",
  },
];


const chatItems = [
  {
    message: "A clean contact form is the standard. Name, email, message. Let's keep it simple.",
    name: "Assumption",
    isUser: false,
  },
  {
    message: "I never fill those forms. It feels like it goes into a blank hole.",
    isUser: true,
  },
  {
    message: "I'd rather send a WhatsApp message than fill three fields and wait for a reply.",
    isUser: true,
  },
  {
    message: "The last time I used a form like this, no one responded. I just called a broker I already knew.",
    isUser: true,
    name: "what users actually said",
  },
  
];
---

<Layout title="Real Estate Plattform | Product Design">
      <SEO
      title="Real Estate Platform | Nathalia Troina"
      description="Improving property search by integrating neighborhood insights, user research, and product strategy to support better buying decisions."
      url="https://nathalia-lt.github.io/nathaliatroina/projects/real-estate"
    />
  </Fragment>
      
  <ProjectHero
    title="Real Estate"
    subtitle="Reducing platform exit points by integrating micro-location data."
    year="2025"
    role="UX Designer and Front-end Developer in collaboration with: Full Stack Developer"
    imageSrc={hero_img.src}
    imageAlt="Real Estate platform showing property listings and micro-location data"
  />

  <ProjectOverview
    timeline="3 months"
    context="This real estate platform designed to bridge the gap between affluent clients and specialized brokers. The platform simplifies high-end property discovery, provides immersive architectural overviews."
    problem="Built on a rigid, ready-made template, the client’s real estate platform suffered from inflexible filters and a lack of local context. Users had to leave the application to research neighborhood amenities, leading to high drop-off rates. Additionally, the pre-made software enforced impersonal contact forms that clashed with the Brazilian market, where WhatsApp is the standard for business."
    goals={[
      "Replace static, generic search bars with a dynamic filtering system.",
      "Integrate micro-location data directly into property pages to enhance user engagement and reduce exit rates.",
      "Implement a context-aware messaging system to increase the quality of leads and streamline communication between users and brokers.",
    ]}
    process="Desk research, competitive analysis, heuristic analysis, JTBD, HMW, prototyping."
    tools={["Figma, Analytics"]}
      results={[
        "Shipped a live freelance project, tracked with Google Analytics and Microsoft Clarity.",
        "Redesigned property discovery around micro-location data — targeting the 41% dropout rate uncovered in research.",
        "Designed a WhatsApp-first contact flow for a market where 6+ hour response times are the norm.",
      ]}
    col1={["timeline", "context", "problem", "goals"]}
    col2={["process", "prototype", "tools", "results"]}
  />




  <productPageSection
    title="41% of real estate agency interactions end in dropouts."
    description="That single number tells you almost everything about how broken the discovery-to-contact journey is in real estate. Users find a property they like — then hit a wall of generic filters, no neighborhood context, and a contact form that feels like sending a message into the void."
  >
  </productPageSection>

  
  

  <ProductPageSection
    sectionClassName="mb-0"
    title="Research"
    description="To understand the current landscape of real estate platforms and identify opportunities for improvement, I conducted comprehensive research. Secondary data were collected and analyzed from sources such as: GOV, Exame, Diário do Comércio, and NMSC."
  >
    <TypographyH4 >Key findings</TypographyH4>
    <TypographyList
      list={[
        "41% of real estate agency interactions end in dropouts, survey indicates.",
        "Real estate agencies in Brazil take over six hours to respond to clients interested in renting properties.",
        "Post-contact, Plaza's research revealed that only 40.74% of contacts received a follow-up after initial disengagement.",
        "The real estate market was valued at US$ 9.8 trillion in 2023, with projected growth to US$ 13.9 trillion by 2030, at a CAGR of 5.8% from 2024 to 2030.",
        "Brazil has over 600,000 registered brokers — the 2nd largest market in the world."
      ]}
    />
    <TypographyH3 className="mt-4xl">Competitive Analysis</TypographyH3>
    <TypographyP>Every competitor I analyzed made the same trade-off: scale over specificity.</TypographyP
    >
    <TypographyList
      list={[
        "QuintoAndar and ZAP optimize for volume, leaving high-end users overwhelmed by generic filters and unverified listings.",
        "Loft and OLX generate information noise — high drop-off driven by unverified listings and zero neighborhood context.",
        "Across the board, filtering systems were built for the mass market, not for buyers with specific, non-negotiable criteria.",
      ]}
    />
  </ProductPageSection>
  <ImageSection
    src={competitive_analysis.src}
    alt="Real Estate"
    className="mt-0"
  />

  <ProductPageSection
    title="User insights"
    description="The primary group, Property Seekers, was chosen due to time constraints, focusing on high‑income users aged 28–45 who searched for premium properties in the past six months. This includes both those who completed a purchase or rental and those who abandoned the process, with the latter offering the most valuable insight into where trust broke. A few participants relocating from another city or country add depth, as they rely heavily on neighborhood context. Although a secondary group of Brokers could validate lead quality, the most insight-rich choice remains the seekers who dropped off."
>
    <TypographyP>User feedback revealed that the real issue was deeper: users were leaving the platform mid-decision to research neighborhood amenities elsewhere, and the generic contact forms were not meeting their needs for direct, context-aware communication</TypographyP>
    <ChatGroup  chatItems={chatItems} />
    
  </ProductPageSection>

  <ProductPageSection
    client:visible
    title="Problem Statement"
    variant="large"
    description="How might we transform the fragmented property search into a seamless, data-rich discovery journey <mark>that reduces platform exit rates</mark> and leverages a context-aware message bridge to <mark>increase qualified lead generation</mark>?"
  />

  <ProductPageSection
    title="From Insights to Decisions"
    description="Between the 41% drop-off rate and the final designs below, there was a step I had to make visible to myself before I could make it visible to anyone else: turning a business outcome, three distinct user pain points, and my own instincts about what might work into decisions I could actually defend. This is that step, the opportunities I identified, the solutions I considered for each one, and, where I had the chance to test, what the data told me before I moved forward."
  >
  </ProductPageSection>
  <ImageSection
    src={opportunity_tree.src}
    alt="Real Estate Opportunity Solution Tree"
    className="mt-0"
  />



  <ProductPageSection
    title="Jobs to be done"
    description="Understanding users tasks or “jobs” with a product reveals drivers of behaviors, aiding in effective product design for enhanced satisfaction and successes."
  >
    <!-- essa div é o container dos cards, aqui vai decidir os gaps -->
    <div class="flex flex-col gap-md">
      {
        insightsBlockItems.map((item) => (
          <InsightsBlock description={item.description} icon={item.icon} />
        ))
      }
    </div>
  </ProductPageSection>

  <ProductPageSection title="Design Hypotheses">
    <TypographyH3>Micro-location data, built into the page itself</TypographyH3>
    <TypographyP>Users were leaving the platform mid-decision, opening five new tabs to check schools, safety, and transit before coming back, if they came back at all. Embedding that context directly into the property page removes the reason to leave.</TypographyP>
    <TypographyH3 className="mt-lg">A form that already knows what you are asking for</TypographyH3>
    <TypographyP>Generic contact forms make users repeat information the platform already has, which property, which details, what they want to know. I redesigned the form so the message field arrives pre-filled with the property's context; the user only has to add their name, email, and hit send. For users who prefer speaking to a broker directly, WhatsApp is offered as a second, faster contact channel, meeting the market where it already communicates.</TypographyP>
  </ProductPageSection>
  <BeforeAfterToggle
    beforeImage={aptbefore.src}
    afterImage={aptafter.src}
    beforeAlt="before image"
    afterAlt="after image"
    
    client:load
  />

  <ProductPageSection>
    <TypographyH3>Filtering System</TypographyH3>
    <TypographyP
      >We believe that engineering a specialized dynamic filtering system
      tailored to real estate platforms will allow users to refine searches
      based on high-end criteria, thereby <strong
        >reducing time-to-discovery and increasing the search success rate</strong>.</TypographyP>
    <TypographyH3 className="mt-lg">Tags</TypographyH3>
    <TypographyP
      >Introduced contextual property amenity tags (e.g., gym, pool, play area) directly into overview cards, designed to improve immediate scannability.</TypographyP>    
  </ProductPageSection>
    <BeforeAfterToggle
    beforeImage={filterbefore.src}
    afterImage={filterafter.src}
    beforeAlt="before image"
    afterAlt="after image"
    
    client:load
  />

<!-- To measure the impact of our design changes, we established clear success metrics, including a 20% increase in user engagement and a 15% reduction in drop-off rates. We tracked these metrics using analytics tools and user feedback to ensure that our improvements were effective and aligned with our goals. -->

  <ImpactSection
    client:visible
    title="Measuring Impact"
    description="The platform is live, and I've implemented Google Analytics and Microsoft Clarity to track real user behavior against the metrics below. The data collection window is still early, so the numbers aren't in yet, but here's exactly what I'm measuring and why each metric ties back to the core problem:"
    impacts={[
      {
        icon: "map",
        title: "User Retention",
        description:
          "Session duration and platform exit rate on property pages, to test whether embedding micro-location data actually keeps users on-page instead of tab-switching to research neighborhoods elsewhere.",
      },
      {
        icon: "message",
        title: "Lead Quality",
        description:
          "Form completion rate and time-to-broker-response, to test whether the pre-filled message reduces the friction that was causing drop-off in traditional forms.",
      },
      {
        icon: "chart",
        title: "Search Efficiency",
        description:
          "Time-to-first-saved-listing, to test whether the new filtering system actually shortens the path to a relevant match.",
      },
      {
        icon: "tags",
        title: "Channel Efficiency",
        description:
          "% of users choosing WhatsApp vs. the in-app form, which will tell me whether the cultural bet on WhatsApp was the right call — or whether the pre-filled form alone was enough.",
      },
    ]}
    nextSteps={[
      "User test: Usability testing, observation and users analysis, being moderated and unmoderated.",
      "Heatmaps analysis: Conducting a heatmap analysis to understand user interaction patterns and identify areas for improvement.",
      "Implement a recommendation engine that suggests properties based on the user's browsing history and saved favorites.",
      "Sun Path Visualization: Developing a custom interactive tool to visualize natural lighting.",
    ]}
  >
    <TypographyList
      list={[
        "User experience principles can be universal, but they are often still filtered by cultural context. While a standard email form might work for international markets, the Brazilian real estate market demands a WhatsApp approach.",
        "Unfortunately, many constraints do not emerge until well into the design process. Working through the design of user experience and assessing feasibility of design concepts reveals constraints.",
      ]}
    />
  </ImpactSection>
</Layout>
